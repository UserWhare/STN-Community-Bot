# Create a NEW bot token in https://discord.com/developers/applications
DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# Optional. Leave blank to register commands in every server the bot joins.
# Setting this to your server ID restricts configuration to that server.
GUILD_ID=

# Local, writable storage directory. Keep this directory backed up.
DATA_DIR=./data

# Optional custom emojis available to the bot; Unicode emoji work by default.
# VOICE_EMOJI_LIMIT=<:limit:123456789012345678>
# VOICE_EMOJI_PRIVACY=🔒
# VOICE_EMOJI_DELETE=🗑️
# VOICE_EMOJI_UNLOCK=🔓
# VOICE_EMOJI_BLOCK=🚫
# VOICE_EMOJI_TRUST=✅
# VOICE_EMOJI_KICK=📞
# VOICE_EMOJI_UNTRUST=❌
# VOICE_EMOJI_TRANSFER=👑
